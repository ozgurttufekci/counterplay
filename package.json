    "postinstall": "npm run prepare:engine"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "react": "^19.2.0",
    "react-chessboard": "5.12.1",
    "react-dom": "^19.2.0",
    "stockfish": "19.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
